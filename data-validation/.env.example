# Copy to .env locally. Never paste keys into chat or commit .env.
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=

# vitalik.eth public address; a literal 0x address is required (no ENS lookup).
TEST_ADDRESS=0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045
REQUEST_TIMEOUT_MS=15000
MAX_RETRIES=3
RETRY_BASE_MS=1000
RETRY_MAX_MS=10000
# Serial request spacing, also applies to retries.
REQUEST_INTERVAL_MS=600

# Newest first. Freeze the end block once per check before paginating.
START_BLOCK=0
# Optional decimal block; if blank, snapshot current Ethereum block.
END_BLOCK=
TX_PAGE_SIZE=25
TX_MAX_PAGES=2
TX_LIMIT=50
TRANSFER_PAGE_SIZE=25
TRANSFER_MAX_PAGES=2
# Per direction (incoming and outgoing are independent).
TRANSFER_LIMIT=50
