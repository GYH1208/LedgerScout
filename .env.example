# Fill keys locally. Never send keys in chat or commit .env.
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Free US equity data. SEC needs your real application/contact identity, not an API key.
FMP_API_KEY=
# ETF market prices (Twelve Data Basic). Keep the key local.
TWELVE_DATA_API_KEY=
TWELVE_DATA_DAILY_LIMIT=600
SEC_USER_AGENT=
# Maximum local FMP attempts per UTC day; retries and failures also count.
FMP_DAILY_LIMIT=200

# Data transport configuration; CLI defaults retain the validation behavior.
REQUEST_TIMEOUT_MS=15000
MAX_RETRIES=3
REQUEST_INTERVAL_MS=600
